# WebbMC settings. Copy this file to ".env" in the same folder and fill it in.
# The panel reads .env when it starts, so restart it after changing anything.
# On Railway, put these in the service's Variables tab instead: .env is never uploaded there.

# ---- Accounts ----------------------------------------------------------------
# Everyone signs in with an account and manages their own servers. Accounts use a username and password,
# made on the sign-in page. On a new panel the first account created becomes the admin.
# Forgot the admin password? Run "node reset-admin.js" in this folder for a one-time password.

# Optional: Google sign-in. Leave both blank for username and password only.
# Create them at https://console.cloud.google.com/ > APIs & Services > Credentials >
# Create credentials > OAuth client ID > Web application, and add these redirect URIs:
#   http://localhost:8420/auth/google/callback          (running on this computer)
#   https://<your-domain>/auth/google/callback          (Railway or another host)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional, needs Google sign-in: Google account emails that are always admins (comma-separated).
# Admins can also be made in Panel settings > Accounts.
WEBMC_ADMIN_EMAILS=

# The address people open the panel at, if it has its own domain. Used for Google's redirect address,
# and its hostname is allowed automatically (no need to repeat it in WEBMC_ALLOWED_HOSTS).
# WEBMC_PUBLIC_URL=https://panel.example.com

# ---- Hostnames ---------------------------------------------------------------
# The panel only answers requests for localhost, IP addresses and the hostnames listed here. This blocks
# DNS-rebinding attacks. Add every domain you open the panel at, comma-separated. The Railway domain and the
# WEBMC_PUBLIC_URL hostname are added automatically. Hostnames can also be added in Panel settings.
# WEBMC_ALLOWED_HOSTS=panel.example.com,mc.example.com

# ---- Other options (all optional) -------------------------------------------
# Panel port and listen address. Open http://localhost:8420 by default.
# WEBMC_PORT=8420
# WEBMC_HOST=127.0.0.1

# Where servers, backups and panel.json are stored (default: ./data).
# WEBMC_DATA=

# Raises GitHub's limit for plugin installs from GitHub and EssentialsX. On Railway it also lets the panel
# check for updates when it is deployed from a private fork.
# GITHUB_TOKEN=

# Lets modpack uploads download the mods listed by a CurseForge export (a zip with manifest.json). Free at
# https://console.curseforge.com/. Server packs (the zip of server files) install without it.
# CURSEFORGE_API_KEY=

# Optional: lets accounts connect a Microsoft account on the Server status page, to see which Xbox friends are online
# and which Minecraft worlds they broadcast (handy for checking MCXboxBroadcast). Free: register an app at
# https://entra.microsoft.com/ > App registrations, for "Personal Microsoft accounts only", and turn on
# Authentication > Allow public client flows. No secret or redirect URI is needed. Paste its Application (client) ID.
# XBOX_CLIENT_ID=

# Optional: show new commits in the bell the moment you push. Set a long random secret here, restart, and add a
# webhook in the GitHub repository (Settings > Webhooks): Payload URL https://<your-domain>/api/update/webhook,
# content type application/json, the same secret, just the push event. Without it, pushes still show up within a
# minute while the panel is open (and within half an hour otherwise).
# WEBMC_WEBHOOK_SECRET=

# Where a playit you installed yourself listens, if you start it with --socket-path. WebbMC finds a playit
# installed the normal way by itself (/run/playit/playitd.sock on Linux, the playitd-system pipe on Windows).
# WEBMC_PLAYIT_SOCKET=/run/playit/playitd.sock

# Set to 1 to run without the restart helper. The "Stop servers and update" button then stops the panel
# after updating instead of restarting it.
# WEBMC_NO_SUPERVISOR=1

# Extra Java executables to offer in each server's Java field (comma-separated). Not needed normally:
# the panel finds Java on PATH and downloads the version a server needs.
# WEBMC_JAVA_PATHS=/usr/lib/jvm/java-21/bin/java
